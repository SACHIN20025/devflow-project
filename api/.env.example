# Server
PORT=5000
NODE_ENV=development

# Database
# Default: local SQLite file — zero setup, great for grading/demoing.
# To use MySQL or Postgres instead, set DB_DIALECT to "mysql" or "postgres"
# and fill in the connection fields below (see src/config/database.js).
DB_DIALECT=sqlite
DB_STORAGE=./data/devflow.sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devflow
DB_USER=postgres
DB_PASSWORD=changeme

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AI feature — get a FREE key at https://aistudio.google.com/app/apikey
# No credit card required. The AI endpoints work without this key too: they
# fall back to a clearly-labeled local heuristic so the app still runs
# end-to-end in a demo either way.
GEMINI_API_KEY=

# CORS
CLIENT_ORIGIN=http://localhost:5173
